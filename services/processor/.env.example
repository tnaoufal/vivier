# Shared bearer secret the Vivier Worker sends to this service (the same
# value as PROCESSOR_SHARED_SECRET on the Worker). At least 32 characters
# (openssl rand -hex 32); a shorter value refuses to start unless
# PROCESSOR_ALLOW_INSECURE_SECRET=1 (local or CI smoke tests only).
PROCESSOR_SHARED_SECRET=

# Supabase project URL and service role key. Both optional at start: without
# them the service answers /health only and processes nothing.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Model (optional): any OpenAI-compatible API. Without LLM_API_KEY the
# service runs in "no model" mode (regex-only profiles, no embeddings).
# LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
# LLM_MODEL=mistral-small-latest
# LLM_EMBEDDING_MODEL=mistral-embed

# OCR for scanned PDFs (optional): Mistral's OCR API.
MISTRAL_OCR_API_KEY=
# MISTRAL_OCR_MODEL=mistral-ocr-latest

# HTTP port
PORT=8080

# Timers and limits (optional)
# POLL_INTERVAL_MS=20000
# MAINTENANCE_INTERVAL_MS=3600000
# PROCESSOR_CONCURRENCY=2
# MAX_TEXT_CHARS=200000
