{
  "name": "vivier-processor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vivier's CV processor: turns uploaded PDFs into structured candidates (Supabase, Railway).",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build:analysis": "tsc -p ../../packages/analysis/tsconfig.json",
    "prebuild": "npm run build:analysis",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "pretest": "npm run build:analysis",
    "test": "vitest run",
    "pretypecheck": "npm run build:analysis",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "@vivier/analysis": "file:../../packages/analysis",
    "fastify": "^5.2.0",
    "openai": "^5.0.0",
    "unpdf": "^0.12.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
